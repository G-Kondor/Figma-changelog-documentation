{
  "name": "Changelog & documentation",
  "id": "changelog-documentation-plugin",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": ["figma", "dev"],
  "capabilities": ["inspect"],
  "permissions": ["teamlibrary"],
  "documentAccess": "dynamic-page",
  "networkAccess": {
    "allowedDomains": [
      "https://gergokondor.atlassian.net",
      "http://localhost:3001"
    ],
    "reasoning": "Connects to Confluence REST API for publishing changelogs. Localhost proxy used during development to bypass CORS."
  }
}
